<div class="hero-section">
  <div class="hero-content">
    <h2>Bienvenido a LiberMU</h2>
    <p class="hero-text">Unete a la aventura. Crea tu cuenta y comienza a jugar hoy mismo.</p>
    <div class="hero-buttons">
      <a href="/register" class="btn btn-primary">Crear Cuenta</a>
      <a href="/download" class="btn btn-secondary">Descargar Cliente</a>
    </div>
  </div>
</div>

<div class="server-status-section">
  <div class="server-status-card <%= serverStatus.online ? 'server-online' : 'server-offline' %>">
    <div class="status-icon">
      <span class="status-pulse"></span>
    </div>
    <div class="status-info">
      <h3>Estado del Servidor</h3>
      <div class="status-big-text"><%= serverStatus.online ? 'ONLINE' : 'OFFLINE' %></div>
      <p class="status-detail">
        <% if (serverStatus.online) { %>
          El servidor esta activo y listo para jugar.
        <% } else { %>
          El servidor esta en mantenimiento. Volve mas tarde.
        <% } %>
      </p>
      <div class="status-meta">
        <span class="meta-item">IP: 216.238.105.18</span>
        <span class="meta-item">Puerto: 44406</span>
        <span class="meta-item">Season 6 EP3</span>
        <span class="meta-item">Jugadores: <%= serverStatus.players %></span>
      </div>
    </div>
  </div>
</div>

<div class="economy-section">
  <div class="economy-header">
    <h2>Economia LiberMU</h2>
    <p class="economy-subtitle">Un sistema disenado para que el comercio entre jugadores sea justo, sostenible y sin inflacion infinita.</p>
  </div>

  <div class="economy-grid">
    <div class="economy-card">
      <div class="economy-icon zen-icon">Z</div>
      <h3>El Zen es Combustible</h3>
      <p>El Zen <strong>se gasta</strong>, no se acumula para siempre. Se usa para pagar comisiones, reparar items, teletransportarte y consumir servicios. Cada Zen que gastas se destruye, evitando la inflacion.</p>
      <ul class="economy-list">
        <li>Reparaciones caras (x2)</li>
        <li>Comisiones de cambio: 500k</li>
        <li>Teleport y consumibles</li>
      </ul>
    </div>

    <div class="economy-card">
      <div class="economy-icon jewel-icon">J</div>
      <h3>Las Joyas son tu Banco</h3>
      <p>Las Joyas son la <strong>moneda fuerte</strong> del servidor. No se devaluan porque no entran infinitas al mundo. Son la reserva de valor para items caros y transacciones grandes entre jugadores.</p>
      <ul class="economy-list">
        <li>Bless < Soul < Life < Chaos</li>
        <li>Drop reducido al maximo</li>
        <li>Negocio P2P con ellas</li>
      </ul>
    </div>

    <div class="economy-card">
      <div class="economy-icon npc-icon">N</div>
      <h3>NPCs = Servicios, No Competencia</h3>
      <p>Los NPCs <strong>no venden items ni joyas</strong>. Solo prestan servicios que cobran en Zen. Ellos no compiten con los jugadores, son infraestructura para que hagas negocios.</p>
      <ul class="economy-list">
        <li><strong>Cambista:</strong> Intercambia joyas (swap)</li>
        <li><strong>Corredor:</strong> Escrow seguro (2%)</li>
        <li><strong>Alquimista:</strong> Buffs temporales</li>
      </ul>
    </div>

    <div class="economy-card">
      <div class="economy-icon sink-icon">S</div>
      <h3>Anti-Inflacion Garantizada</h3>
      <p>El Zen que entra por drops <strong>sale por los sinks</strong>. Chaos Machine caro, reparaciones caras, comisiones, buffs de tiempo. El Zen se destruye constantemente, manteniendo su valor estable.</p>
      <ul class="economy-list">
        <li>Chaos Machine: x5 mas caro</li>
        <li>Durabilidad x2 mas rapida</li>
        <li>EXP x100 para progresar</li>
      </ul>
    </div>
  </div>

  <div class="economy-summary">
    <p><strong>Resumen:</strong> Farmea Zen para usarlo. Acumula Joyas para tradear. El mercado lo manejan los jugadores, no los NPCs. Asi la economia se mantiene viva mes tras mes.</p>
  </div>
</div>

<!-- Market Prices Widget -->
<div class="economy-section" style="margin-top: 2rem;">
  <div class="economy-header">
    <h2>Precios del Mercado</h2>
    <p class="economy-subtitle">Valores de referencia en Joyas, establecidos por la administracion. Siempre conviene comprar P2P entre jugadores.</p>
  </div>

  <div class="rankings-grid" id="market-prices-widget" style="margin-bottom: 1rem;">
    <div class="ranking-card">
      <h3>Precios de Referencia</h3>
      <p class="ranking-desc">En unidades de <strong>Jewel of Bless</strong> (moneda base).</p>
      <div class="reference-prices" id="home-reference-prices">
        <div class="price-row"><span class="price-item">Cargando...</span><span class="price-value">-</span></div>
      </div>
    </div>

    <div class="ranking-card">
      <h3>Ultimas Transacciones</h3>
      <p class="ranking-desc">Intercambios recientes entre jugadores.</p>
      <div class="reference-prices" id="home-recent-tx">
        <p class="text-muted" style="text-align:center;padding:1rem 0;">No hay transacciones registradas aun.</p>
      </div>
    </div>

    <div class="ranking-card">
      <h3>Banco del Sistema</h3>
      <p class="ranking-desc">Zen recaudado en comisiones y sinks.</p>
      <div class="reference-prices" id="home-system-bank">
        <div class="price-row"><span class="price-item">Total recaudado</span><span class="price-value" id="sys-bank-zen">-</span></div>
        <div class="price-row"><span class="price-item">Transacciones</span><span class="price-value" id="sys-bank-tx">-</span></div>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 1rem;">
    <a href="/rankings" class="btn btn-secondary">Ver Rankings Completos</a>
  </div>
</div>

<div class="info-grid">
  <div class="info-card">
    <h3>Season 6 EP3</h3>
    <p>La mejor experiencia clasica con contenido extendido y economia mejorada por IA.</p>
  </div>
  <div class="info-card">
    <h3>Economia P2P</h3>
    <p>Sistema de cambistas, escrow y banco para un comercio seguro entre jugadores.</p>
  </div>
  <div class="info-card">
    <h3>Como conectarte</h3>
    <p>1. Descarga el cliente LiberMU<br>2. Ejecuta Main.exe<br>3. Crea tu cuenta desde esta web</p>
  </div>
  <div class="info-card discord-card">
    <h3>Comunidad Discord</h3>
    <p>Unite a nuestro Discord para soporte, tradeo y eventos exclusivos.</p>
    <a href="https://discord.gg/gUeHUANPc" target="_blank" class="btn btn-small btn-discord">Unirse a Discord</a>
  </div>
</div>

<script>
async function loadHomeMarketData() {
  try {
    const [marketRes, bankRes] = await Promise.all([
      fetch('/api/economy/market'),
      fetch('/api/economy/systembank')
    ]);

    const marketData = await marketRes.json();
    const bankData = await bankRes.json();

    // Reference prices
    const refContainer = document.getElementById('home-reference-prices');
    if (marketData.referencePrices && marketData.referencePrices.length > 0) {
      refContainer.innerHTML = marketData.referencePrices.map(p => `
        <div class="price-row">
          <span class="price-item">${p.ItemName}</span>
          <span class="price-value">${parseFloat(p.PriceInBless).toFixed(1)} Bless</span>
        </div>
      `).join('');
    } else {
      refContainer.innerHTML = '<div class="price-row"><span class="price-item">No hay precios configurados.</span><span class="price-value">-</span></div>';
    }

    // Recent transactions
    const txContainer = document.getElementById('home-recent-tx');
    if (marketData.recentTransactions && marketData.recentTransactions.length > 0) {
      txContainer.innerHTML = marketData.recentTransactions.slice(0, 5).map(tx => {
        const date = new Date(tx.Timestamp).toLocaleString('es-AR', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
        const price = tx.PriceZen ? `${tx.PriceZen.toLocaleString('es-AR')} Zen` : (tx.PaymentItemName ? `${tx.PaymentItemQuantity}x ${tx.PaymentItemName}` : '-');
        return `<div class="price-row"><span class="price-item">${date} - ${tx.ItemName}</span><span class="price-value">${price}</span></div>`;
      }).join('');
    } else {
      txContainer.innerHTML = '<p class="text-muted" style="text-align:center;padding:1rem 0;">No hay transacciones registradas aun. Usa <code>/mercado</code> en el juego.</p>';
    }

    // System bank
    if (bankData.systemBank) {
      document.getElementById('sys-bank-zen').textContent = parseInt(bankData.systemBank.TotalZenCollected).toLocaleString('es-AR') + ' Zen';
      document.getElementById('sys-bank-tx').textContent = parseInt(bankData.systemBank.TotalTransactions).toLocaleString('es-AR');
    }
  } catch (err) {
    console.error('Error cargando datos de economia:', err);
    document.getElementById('home-reference-prices').innerHTML = '<div class="price-row"><span class="price-item">Error cargando datos.</span><span class="price-value">-</span></div>';
  }
}

loadHomeMarketData();
</script>
