<div class="shop-section">
  <div class="shop-header">
    <h2>Tienda de Joyas</h2>
    <p class="shop-subtitle">Apoya el servidor y recibe joyas para potenciar tu personaje</p>
    <p class="shop-note">Los precios de la tienda son un techo de referencia. Siempre conviene comprar P2P con otros jugadores.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <div class="shop-grid">
    <div class="shop-card shop-featured">
      <div class="shop-badge">POPULAR</div>
      <div class="shop-icon">&#128142;</div>
      <h3>Pack Mensual Starter</h3>
      <div class="shop-price">
        <span class="price-value">$5 USD</span>
        <span class="price-period">/ mes</span>
      </div>
      <div class="shop-contents">
        <div class="shop-item">
          <span class="item-icon bless-icon">&#128142;</span>
          <span class="item-name">Jewel of Bless</span>
          <span class="item-qty">x5</span>
        </div>
        <div class="shop-item">
          <span class="item-icon soul-icon">&#128142;</span>
          <span class="item-name">Jewel of Soul</span>
          <span class="item-qty">x5</span>
        </div>
      </div>
      <div class="shop-legend">
        <p>&#9733; Entrega manual via comando /entregar en el juego.</p>
        <p>&#9733; Contacta al admin por Discord luego de enviar el pedido.</p>
      </div>

      <form method="POST" action="/shop/order" class="shop-form">
        <div class="form-group">
          <label for="game_account">Cuenta de juego</label>
          <input type="text" id="game_account" name="game_account" required minlength="3" maxlength="10" placeholder="Tu usuario de MU">
        </div>
        <div class="form-group">
          <label for="contact_method">Metodo de contacto (Discord / WhatsApp)</label>
          <input type="text" id="contact_method" name="contact_method" placeholder="usuario#1234">
        </div>
        <div class="form-group">
          <label for="notes">Notas (opcional)</label>
          <textarea id="notes" name="notes" rows="2" placeholder="Horario preferido de entrega, etc."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Solicitar Compra</button>
      </form>
    </div>
  </div>
</div>
